# Copy this file to .env for local dev (npm run dev).
# For the deployed GitHub Pages build, these same values are supplied
# as GitHub Actions secrets instead (see README "Deploying" section) —
# you do NOT commit a real .env file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
